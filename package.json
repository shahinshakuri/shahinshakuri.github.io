    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "@axe-core/playwright": "4.14.1",
    "@cspell/dict-fr-fr": "2.3.2",
    "@playwright/test": "1.65.1",
    "cspell": "10.5.2",
    "lighthouse": "13.6.0",
    "linkinator": "8.1.0",
