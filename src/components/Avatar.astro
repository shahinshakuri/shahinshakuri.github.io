---
// Avatar graphique « SS » (pas de photo, voir le brief).
// Sur grand écran, une grande version est posée au centre de la fractale de l'accueil.
import { profil } from '../data/profil';

interface Props {
  taille?: number;
}
const { taille = 40 } = Astro.props;
---

<svg
  class="avatar"
  width={taille}
  height={taille}
  viewBox="0 0 64 64"
  role="img"
  aria-label={`Initiales de ${profil.nom}`}
>
  <rect x="2" y="2" width="60" height="60" rx="14" class="avatar__cadre"></rect>
  <text x="32" y="41" text-anchor="middle" class="avatar__texte">{profil.initiales}</text>
</svg>

<style>
  .avatar__cadre {
    fill: var(--surface);
    stroke: var(--accent);
    stroke-width: 2;
  }
  .avatar__texte {
    fill: var(--accent);
    font-family: var(--police-mono);
    font-size: 26px;
    font-weight: 700;
  }
</style>
